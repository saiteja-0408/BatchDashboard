{
  "name": "batch-dashboard",
  "version": "1.0.0",
  "description": "Centralized batch job monitoring dashboard — replaces Excel-based manual tracking",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev:server": "nodemon server/app.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "generate-sample": "node scripts/generateTestData.js",
    "install:all": "npm install && cd client && npm install",
    "test": "jest tests/"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
