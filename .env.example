# Server
PORT=4000
NODE_ENV=development

# Excel Data — two files loaded at startup
# DATA_DIR is the directory containing benefits.xlsx and tax.xlsx
DATA_DIR=./data

# ── Status Report database backend ────────────────────────────────────────────
# STATUS_REPORT_DB selects which database the Status Report tab queries.
#   db2  → IBM DB2  (default — uses DB2_* credentials below)
#   pg   → PostgreSQL (uses PG_* credentials below)
#
# USE_MOCK_DATA=true always overrides STATUS_REPORT_DB and returns static data.
# If USE_MOCK_DATA is absent and the required credentials for the selected
# backend are missing, mock mode activates automatically.
STATUS_REPORT_DB=db2
USE_MOCK_DATA=true

# ── DB2 Connection (STATUS_REPORT_DB=db2) ─────────────────────────────────────
DB2_HOST=
DB2_PORT=50000
DB2_DATABASE=
DB2_USER=
DB2_PASSWORD=
DB2_SCHEMA=db2prd1

# ── PostgreSQL Connection (STATUS_REPORT_DB=pg) ───────────────────────────────
# Option A — Connection URL (use this if you have a pg URL):
PG_CONNECTION_URL=
# Option B — Individual variables (use if you don't have a URL):
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SCHEMA=public

# Client (used by Vite proxy — no trailing slash)
VITE_API_BASE_URL=http://localhost:4000
