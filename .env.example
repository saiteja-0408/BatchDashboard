# ── Environment file location ─────────────────────────────────────────────────
# This file lives at the PROJECT ROOT (BatchDashboardUI/.env).
# The Node server reads it via `require('dotenv').config()` in server/app.js.
# Vite reads it because vite.config.mjs sets `envDir: '..'` (one level up from
# client/).  You do NOT need a separate client/.env file.
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Server
PORT=4000
NODE_ENV=development

# Excel Data — two files loaded at startup
# DATA_DIR is the directory containing benefits.xlsx and tax.xlsx (default: ./data)
# You can also configure explicit file paths for benefits and tax workbooks:
DATA_DIR=./data
BENEFITS_EXCEL_PATH=
TAX_EXCEL_PATH=

# ── Status Report database backend ────────────────────────────────────────────
# STATUS_REPORT_DB selects which database the Status Report tab queries.
#   db2  → IBM DB2  (default — uses DB2_* credentials below)
#   pg   → PostgreSQL (uses PG_* credentials below)
#
# USE_MOCK_DATA=true always overrides STATUS_REPORT_DB and returns static data.
# If USE_MOCK_DATA is absent and the required credentials for the selected
# backend are missing, mock mode activates automatically.
STATUS_REPORT_DB=db2
USE_MOCK_DATA=true

# ── DB2 Connection (STATUS_REPORT_DB=db2) ─────────────────────────────────────
DB2_HOST=
DB2_PORT=50000
DB2_DATABASE=
DB2_USER=
DB2_PASSWORD=
DB2_SCHEMA=db2prd1

# ── PostgreSQL Connection (STATUS_REPORT_DB=pg) ───────────────────────────────
# Option A — Connection URL (use this if you have a pg URL):
PG_CONNECTION_URL=
# Option B — Individual variables (use if you don't have a URL):
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SCHEMA=public

# ── Status Report cache TTL ───────────────────────────────────────────────────
# STATUS_REPORT_CACHE_TTL_MS controls how long the server caches DB query results.
# Set this equal to (or lower than) VITE_STATUS_REPORT_REFRESH_INTERVAL_MS so
# that every browser poll after the TTL has expired triggers a fresh DB query.
#
# If unset, the server automatically uses VITE_STATUS_REPORT_REFRESH_INTERVAL_MS.
# If both are unset, the default is 10000 ms (10 s).
STATUS_REPORT_CACHE_TTL_MS=10000

# ── Remote Log Server (SSH) ───────────────────────────────────────────────────
# Used by the "Get Logs" feature to SSH into the batch server and fetch log files.
# LOG_SSH_PORT defaults to 22 if not set.
# LOG_FETCH_LINES controls how many tail lines are returned (default: 500).
LOG_SSH_HOST=
LOG_SSH_PORT=22
LOG_SSH_USER=
LOG_SSH_PASSWORD=

# ── SSH Run Command feature toggle ───────────────────────────────────────────
# Set to true to enable the "Run" buttons in the Command Viewer panel.
# When false (default), the buttons are hidden in the UI and the backend
# endpoint returns 403 if called directly.
ENABLE_SSH_RUN_COMMAND=false
# Expose the toggle to the Vite client build (MUST match ENABLE_SSH_RUN_COMMAND)
VITE_ENABLE_SSH_RUN_COMMAND=false

# Client (used by Vite proxy — no trailing slash)
VITE_API_BASE_URL=http://localhost:4000
VITE_STATUS_REPORT_REFRESH_INTERVAL_MS=10000
