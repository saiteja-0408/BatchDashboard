# Server
PORT=4000
NODE_ENV=development

# Excel Data — two files loaded at startup
# DATA_DIR is the directory containing benefits.xlsx and tax.xlsx
DATA_DIR=./data

# DB2 / Mock mode
# USE_MOCK_DATA=true  → return realistic static data; no DB2 connection needed.
# USE_MOCK_DATA=false → use a real DB2 connection (requires credentials below).
# If USE_MOCK_DATA is absent, mock mode activates automatically when any
# DB2_* credential is missing — so local dev works with zero configuration.
USE_MOCK_DATA=true

# DB2 Connection (only needed when USE_MOCK_DATA=false)
DB2_HOST=
DB2_PORT=50000
DB2_DATABASE=
DB2_USER=
DB2_PASSWORD=
DB2_SCHEMA=db2prd1

# Client (used by Vite proxy — no trailing slash)
VITE_API_BASE_URL=http://localhost:4000
